            </column>
            <column caption='{[% difference sales]}' datatype='real' name='[Calculation_0449464484290566]' role='measure' type='quantitative' user:unnamed='KPI Sales'>
              <calculation class='tableau' formula='{[Calculation_0449464478982147]}' />
            </column>
