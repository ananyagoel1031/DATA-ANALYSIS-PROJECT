              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qqhy0t0sweb7u1dy77ph12okeqd'>
            <column caption='Current year sales' datatype='real' default-format='n&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_0449464477253632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])= [Parameters].[Parameter 1] THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='Previous Year Sales' datatype='real' default-format='n&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_0449464477532161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If YEAR([Order Date])=[Parameters].[Parameter 1]-1 THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='% difference sales' datatype='real' default-format='p0.0%' name='[Calculation_0449464478982147]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_0449464477253632])-SUM([Calculation_0449464477532161]))/SUM([Calculation_0449464477532161])' />
            </column>
            <column caption='Min/Max Sales' datatype='real' default-format='n0,K;-0,K' name='[Calculation_0449464482025476]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([Calculation_0449464477253632])=WINDOW_MAX(SUM([Calculation_0449464477253632])) THEN SUM([Calculation_0449464477253632])&#13;&#10;ELSEIF SUM([Calculation_0449464477253632])=WINDOW_MIN(SUM([Calculation_0449464477253632])) THEN SUM([Calculation_0449464477253632])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
