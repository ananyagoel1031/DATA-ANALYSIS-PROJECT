            </column>
            <column aggregation='CountD' caption='CY Customers' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1283994415968256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1] THEN ([Customer ID (Customers.csv)])&#13;&#10;END' />
            </column>
            <column aggregation='CountD' caption='PY CUSTOMER' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1283994416615425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1]-1 THEN [Customer ID]&#13;&#10;END' />
            </column>
            <column caption='max/min customers' datatype='integer' name='[Calculation_1283994417410050]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([Calculation_1283994415968256])=WINDOW_MAX(COUNTD([Calculation_1283994415968256])) THEN COUNTD([Calculation_1283994415968256])&#13;&#10;ELSEIF COUNTD([Calculation_1283994415968256])=WINDOW_MIN(COUNTD([Calculation_1283994415968256])) THEN COUNTD([Calculation_1283994415968256])&#13;&#10;END'>
