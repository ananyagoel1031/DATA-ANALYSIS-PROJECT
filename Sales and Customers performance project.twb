        <view>
          <datasources>
            <datasource caption='Sales data source' name='federated.0qqhy0t0sweb7u1dy77ph12okeqd' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2023'>
              <calculation class='tableau' formula='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qqhy0t0sweb7u1dy77ph12okeqd'>
            <column caption='Current year sales' datatype='real' default-format='n&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_0449464477253632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])= [Parameters].[Parameter 1] THEN [Sales]&#13;&#10;END' />
            </column>
            <column caption='Previous Year Sales' datatype='real' default-format='n&quot;$&quot;#,##0,.0K;-&quot;$&quot;#,##0,.0K' name='[Calculation_0449464477532161]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If YEAR([Order Date])=[Parameters].[Parameter 1]-1 THEN [Sales]&#13;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Current year' datatype='integer' default-format='n0;-0' name='[Calculation_0449464488108039]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' default-format='n0;-0' name='[Calculation_0449464488288264]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column aggregation='CountD' caption='CY Customers' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1283994415968256]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1] THEN ([Customer ID (Customers.csv)])&#13;&#10;END' />
            </column>
            <column aggregation='CountD' caption='PY CUSTOMER' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1283994416615425]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1]-1 THEN [Customer ID]&#13;&#10;END' />
            </column>
            <column caption='% diff customers' datatype='real' default-format='p0.0%' name='[Calculation_1283994420260867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_1283994415968256])-COUNTD([Calculation_1283994416615425]))/COUNTD([Calculation_1283994416615425])' />
            </column>
            <column caption='KPI Cust CY less PY' datatype='string' name='[Calculation_1283994422177798]' role='measure' type='nominal'>
              <calculation class='tableau' formula='If COUNTD([Customer ID]) &lt; COUNTD([Customer ID]) THEN &apos;-&apos;&#13;&#10;ELSE &apos; &apos;&#13;&#10;END' />
            </column>
            <column caption='CY Sales per customer' datatype='real' name='[Calculation_1283994423422983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0449464477253632]) / COUNTD([Calculation_1283994415968256])' />
            </column>
            <column caption='PY Sales per customer' datatype='real' name='[Calculation_1283994423574536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_0449464477532161]) / COUNTD([Calculation_1283994416615425])' />
            </column>
            <column caption='%diff sales per customers' datatype='real' default-format='p0.0%' name='[Calculation_1283994424516618]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1283994423422983]-[Calculation_1283994423574536])/[Calculation_1283994423574536]' />
            </column>
            <column aggregation='CountD' caption='CY Orders' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1283994426503181]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1] THEN [Order ID]&#13;&#10;END' />
            </column>
            <column aggregation='CountD' caption='PY Orders' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1283994426654734]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date])=[Parameters].[Parameter 1]-1 THEN [Order ID]&#13;&#10;END' />
            </column>
            <column caption='% diff orders' datatype='real' default-format='p0.0%' name='[Calculation_1283994426720271]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([Calculation_1283994426503181])-COUNTD([Calculation_1283994426654734]))/COUNTD([Calculation_1283994426654734])' />
            </column>
            <column caption='Max/min orders' datatype='integer' name='[Calculation_1283994427187216]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF COUNTD([Calculation_1283994426503181])=WINDOW_MAX(COUNTD([Calculation_1283994426503181])) THEN COUNTD([Calculation_1283994426503181])&#13;&#10;ELSEIF COUNTD([Calculation_1283994426503181])=WINDOW_MIN(COUNTD([Calculation_1283994426503181])) THEN COUNTD([Calculation_1283994426503181])&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='{COUNTD([CY Orders])}' datatype='integer' name='[Calculation_1283994429157395]' role='measure' type='quantitative' user:unnamed='KPI Orders'>
              <calculation class='tableau' formula='{COUNTD([Calculation_1283994426503181])}' />
            </column>
            <column caption='{[% diff orders]}' datatype='real' name='[Calculation_1283994429194260]' role='measure' type='quantitative' user:unnamed='KPI Orders'>
              <calculation class='tableau' formula='{[Calculation_1283994426720271]}' />
            </column>
